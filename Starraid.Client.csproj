<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>

    <!-- Where the protocol checkout lives, so we can compile its generated C#
         bindings (gen/csharp, gitignored — regenerated by `just gen`). Mirrors the
         Go components' protocol_path/STARRAID_PROTOCOL_PATH convention. Override
         with `-p:ProtocolPath=...` or the STARRAID_PROTOCOL_PATH env var. -->
    <ProtocolPath Condition="'$(ProtocolPath)' == ''">$(STARRAID_PROTOCOL_PATH)</ProtocolPath>
    <ProtocolPath Condition="'$(ProtocolPath)' == ''">$(MSBuildProjectDirectory)/../protocol</ProtocolPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.0" />
  </ItemGroup>

  <!-- The protocol's generated C# bindings, compiled straight from the checkout. -->
  <ItemGroup>
    <Compile Include="$(ProtocolPath)/gen/csharp/**/*.cs" />
  </ItemGroup>
</Project>
