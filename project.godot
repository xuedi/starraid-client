; StarRaid client — Godot 4 (.NET). Skeleton project; see ../docs/client.md.
config_version=5

[application]

config/name="StarRaid"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")

[dotnet]

project/assembly_name="Starraid.Client"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; Crisp pixel-art: 50×50 ship sprites must not blur when scaled/zoomed.
textures/canvas_textures/default_texture_filter=0
